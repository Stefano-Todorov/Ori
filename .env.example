# ===========================================
# Orianna — Environment Variables
# Copy this to .env.local and fill in values
# ===========================================

# App
NEXT_PUBLIC_APP_URL=https://orianna.vercel.app
CRON_SECRET=            # Random secret to protect cron endpoints

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (AI Coach + Script Generation)
ANTHROPIC_API_KEY=

# Stripe (Billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_MAX=
STRIPE_PRICE_MAX_YEARLY=

# Social OAuth — YouTube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=

# Social OAuth — Instagram/Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Social OAuth — TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Apify (Competitor Scraping)
APIFY_API_TOKEN=

# Sentry (Error Monitoring — optional)
# SENTRY_ORG=
# SENTRY_PROJECT=
