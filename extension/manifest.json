{
  "manifest_version": 3,
  "name": "Orianna — AI Content Coach for Creators",
  "version": "1.1.0",
  "description": "🎬 Your AI content coach — save viral inspo, spy on competitors, and get personalized video ideas while scrolling TikTok & Instagram",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "*://*.tiktok.com/*",
    "*://*.tiktokcdn.com/*",
    "*://*.tiktokcdn-us.com/*",
    "*://*.instagram.com/*",
    "*://*.cdninstagram.com/*",
    "*://*.fbcdn.net/*",
    "*://*.youtube.com/*",
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "*://*.reddit.com/*",
    "*://*.facebook.com/*",
    "*://*.snapchat.com/*",
    "*://*.threads.net/*",
    "https://zpowetkkmppaffqbgvzq.supabase.co/*",
    "https://ori-nine.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.tiktok.com/*",
        "*://*.instagram.com/*",
        "*://*.youtube.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.reddit.com/*",
        "*://*.facebook.com/*",
        "*://*.snapchat.com/*",
        "*://*.threads.net/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.tiktok.com/*"
      ],
      "js": [
        "tiktok-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
