{
  "manifest_version": 3,
  "name": "Orianna — AI Content Coach for Creators",
  "version": "1.0.5",
  "description": "Save inspo, track competitors, and generate video ideas while browsing TikTok and Instagram",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.tiktok.com/*",
    "*://*.instagram.com/*",
    "https://zpowetkkmppaffqbgvzq.supabase.co/*",
    "https://ori-nine.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.tiktok.com/*",
        "*://*.instagram.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.tiktok.com/*"
      ],
      "js": [
        "tiktok-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
