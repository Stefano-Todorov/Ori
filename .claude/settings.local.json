{
  "permissions": {
    "allow": [
      "Bash(git commit:*)",
      "Bash(git status*)",
      "Bash(git push*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(npm run dev*)",
      "Bash(npm run build*)",
      "Bash(npx playwright test*)",
      "Bash(npx tsc*)",
      "WebSearch"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsc --noEmit --pretty 2>&1 | head -20"
          }
        ]
      }
    ]
  }
}
